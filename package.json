{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.5.2",
  "scripts": {
    "check": "check && pnpm -r --sequential run check",
    "test": "pnpm -r --sequential run test run",
    "test:coverage": "pnpm -r --sequential run test:coverage",
    "prepare": "simple-git-hooks",
    "prepublish": "pnpm -s build",
    "docs:gen": "typedoc --options docs/typedoc.json",
    "docs:dev": "pnpm -s docs:gen && vitepress dev docs",
    "docs:build": "pnpm -s docs:gen && vitepress build docs",
    "docs:preview": "pnpm -s docs:gen && vitepress preview docs"
  },
  "devDependencies": {
    "@aklinker1/buildc": "catalog:",
    "@aklinker1/check": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@types/fs-extra": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "changelogen": "catalog:",
    "consola": "catalog:",
    "fast-glob": "catalog:",
    "feed": "catalog:",
    "fs-extra": "catalog:",
    "lint-staged": "catalog:",
    "markdown-it-footnote": "catalog:",
    "nano-spawn": "catalog:",
    "prettier": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsx": "catalog:",
    "typedoc": "catalog:",
    "typedoc-plugin-frontmatter": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vitepress": "catalog:",
    "vitepress-knowledge": "catalog:",
    "vitepress-plugin-group-icons": "catalog:",
    "vitest-mock-extended": "catalog:",
    "vue": "catalog:",
    "wxt": "workspace:*"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@algolia/client-search",
        "search-insights"
      ]
    },
    "patchedDependencies": {
      "markdown-it-footnote": "patches/markdown-it-footnote.patch"
    },
    "overrides": {
      "minimatch": "11.0.1",
      "node-forge": "1.4.1",
      "seroval": "1.6.11",
      "happy-dom": "21.0.4",
      "postcss-selector-parser": "7.1.6",
      "zod": "4.6.6",
      "@vitest/mocker": "4.1.12",
      "vite": "6.4.5",
      "sharp": "0.35.5",
      "source-map-js": "1.2.2",
      "@vue/server-renderer": "3.5.42",
      "tinypool": "2.1.2",
      "moment": "2.31.0",
      "brace-expansion": "2.1.7",
      "adm-zip": "0.6.1",
      "svgo": "3.3.5",
      "colord": "2.9.4",
      "vitest": "4.1.11",
      "@faker-js/faker": "10.5.0",
      "nanoid": "3.3.12",
      "browserslist": "4.28.7",
      "postcss": "8.5.23",
      "immutable": "5.1.8",
      "shell-quote": "1.11.0",
      "@babel/core": "7.29.6",
      "ws": "8.21.0",
      "tmp": "0.2.7",
      "uuid": "11.1.1",
      "svelte": "5.55.7",
      "defu": "6.1.5",
      "picomatch": "4.0.4",
      "rollup": "4.59.0",
      "@babel/runtime": "7.26.10",
      "@babel/helpers": "7.26.10",
      "esbuild": "0.25.0",
      "deepmerge": "npm:@stackline/deepmerge@1.1.0",
      "extract-zip": "npm:@electron-internal/extract-zip@1.0.6"
    }
  }
}
